# ── Staging (local development on localhost) ───────────────────────────
# Copy to .env and .env.staging for local work:
#   cp .env.staging.example .env
#
# ngrok is ONLY used in staging — never in production.

APP_ENV=staging

# Database (local Docker Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mystery_mansion?schema=public"

# Auth
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3001"

# Server
PORT=3001
HOSTNAME=localhost

# ── ngrok (staging only — share localhost with friends) ───────────────
# Leave NGROK_AUTHTOKEN empty to run local-only without a tunnel.
NGROK_AUTHTOKEN=""
NGROK_DOMAIN=""
NGROK_REGION="us"

# Optional preset public URL (usually set automatically when ngrok starts)
BASE_URL=""
NEXT_PUBLIC_BASE_URL=""

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
