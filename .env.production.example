# ── Production — set in your hosting dashboard ───────────────────────
# One app deploy. ngrok is NOT used (APP_ENV=production).

APP_ENV=production
NODE_ENV=production

# Postgres (from host addon — Render/Railway/Neon/Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mystery_mansion?schema=public"

# Required
AUTH_SECRET="openssl rand -base64 32"

# Optional — auto-detected on Render/Railway/Fly if omitted:
# BASE_URL="https://your-app.onrender.com"
# NEXTAUTH_URL="https://your-app.onrender.com"
# NEXT_PUBLIC_BASE_URL="https://your-app.onrender.com"

HOSTNAME=0.0.0.0
# PORT is set automatically by most hosts (do not hardcode)
