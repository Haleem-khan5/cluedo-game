# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mystery_mansion?schema=public"

# NextAuth
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — enable "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server
PORT=3000
HOSTNAME=localhost

# ── Public access (ngrok) ─────────────────────────────────────────────
# Canonical public URL — used for invite links, auth callbacks, Socket.IO CORS.
# Set this to your ngrok URL when tunneling (with or without https://).
BASE_URL="https://your-subdomain.ngrok-free.dev"

# Reserved ngrok domain from https://dashboard.ngrok.com/domains (optional)
NGROK_DOMAIN="your-subdomain.ngrok-free.dev"

# ngrok authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=""

# ngrok region: us | eu | ap | au | sa | jp | in (default: us)
NGROK_REGION="us"

# Client-side copy of BASE_URL (set to same value as BASE_URL for invite links)
NEXT_PUBLIC_BASE_URL="https://your-subdomain.ngrok-free.dev"
